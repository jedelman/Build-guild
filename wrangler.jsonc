{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "build-guild",
  "main": "src/index.js",
  "compatibility_date": "2025-05-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "build_guild",
      // For local `wrangler dev` this id is unused. The production database
      // was created with `wrangler d1 create build_guild`.
      "database_id": "80ab167e-706f-427a-8bab-5df04035b3f2"
    }
  ]
}
